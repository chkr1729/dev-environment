# ---- Eza (better ls) -----
alias ls="eza --icons=always --no-user"
# alias ls="eza --color=always --long --git --no-filesize --icons=always --no-time --no-user --no-permissions"

# General Zsh Aliases
alias ll='ls -alF'
alias la='ls -A'
alias ld='ls -d .*'
alias cd='z'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias cd..='cd ..'

# Git Plugin Aliases
alias lg='lazygit'
alias gst='git status'
alias gco='git checkout'
alias gcm='git commit -m'
alias gaa='git add --all'
alias gp='git push'
alias gl='git pull'
alias glog='git log --oneline --decorate --graph --all'
alias gss='git stash save'
alias gpop='git stash pop'

# System Management Aliases
alias update='brew update && brew upgrade && brew cleanup'
alias zshconfig='nvim ~/.zshrc'
alias ohmyzsh='cd ~/.oh-my-zsh'

# Networking Aliases
alias ping='ping -c 5'
alias ports='lsof -iTCP -sTCP:LISTEN -nP'

# Python Plugin Aliases
alias pyclean='find . -name "*.pyc" -delete && find . -name "__pycache__" -delete'
alias py='python3'

alias c='clear'
alias sz='source ~/.zshrc'

# GitHub CLI
alias prs='gh pr list --author @me'
alias prv='gh pr view --web'
alias prc='gh pr create --web'

# ---- Alacritty day/night theme switcher ----
# Swaps the imported theme + opacity in alacritty.toml; Alacritty live-reloads instantly.
#   theme light  → Catppuccin Latte (bright day)
#   theme dark   → Catppuccin Macchiato (soft night)
theme() {
  local cfg="$HOME/.config/alacritty/alacritty.toml"
  local name opacity
  case "$1" in
    light|day)  name="catppuccin_latte";     opacity="0.95" ;;
    dark|night) name="catppuccin_macchiato";  opacity="0.85" ;;
    *) echo "usage: theme {light|dark}"; return 1 ;;
  esac
  sed -i '' -E "s#themes/themes/[A-Za-z0-9_]+\.toml#themes/themes/${name}.toml#" "$cfg"
  sed -i '' -E "s#^opacity = .*#opacity = ${opacity}#" "$cfg"
  echo "Alacritty → ${name} (opacity ${opacity})"
}
